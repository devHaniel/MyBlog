@model Web.ViewModels.CategoryIndexViewModel
@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>
<p><a asp-action="Create" class="btn btn-primary">Crear categoría</a></p>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Post Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Categories?.Any() != true)
        {
            <tr><td colspan="4" class="text-center">No categories found.</td></tr>
        }
        @foreach (var category in Model?.Categories ?? Enumerable.Empty<Application.DTOs.CategoryDto>())
        {
            if (category is not null)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Slug</td>
                    <td>@category.PostCount</td>
                    <td>
                        <a asp-controller="Categories" asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
