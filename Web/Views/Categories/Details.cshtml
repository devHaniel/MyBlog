@model Web.ViewModels.CategoryDetailsViewModel
@{
    ViewData["Title"] = Model.Category.Name;
}

<h2>@Model.Category.Name</h2>

<div class="row mt-3">
    <div class="col-md-4">
        <h4>Category Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Id</dt>
            <dd class="col-sm-10">@Model.Category.Id</dd>
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@Model.Category.Name</dd>
            <dt class="col-sm-2">Slug</dt>
            <dd class="col-sm-10">@Model.Category.Slug</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Category.Description ?? "N/A"</dd>
            <dt class="col-sm-2">Post Count</dt>
            <dd class="col-sm-10">@Model.Category.PostCount</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Category.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.Category.Id" class="btn btn-outline-danger">Eliminar</a>
    <a asp-action="Index" asp-controller="Categories" class="btn btn-link">Back to List</a>
</div>