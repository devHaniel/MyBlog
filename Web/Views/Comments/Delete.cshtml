@model Web.ViewModels.CommentDetailsViewModel
@{
    ViewData["Title"] = "Delete comment";
}

<h1>Delete comment</h1>
<blockquote class="blockquote">@Model.Comment.Content</blockquote>
<p>Are you sure you want to delete this comment?</p>
<form asp-action="DeleteConfirmed" asp-route-id="@Model.Comment.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete permanently</button>
    <a asp-action="Index" asp-route-postId="@Model.Comment.PostId" class="btn btn-secondary">Cancel</a>
</form>
